        /**
         * Render Left Sidebar Molecule Catalog
         */
        function renderMoleculeList() {
            const listEl = document.getElementById('molecule-list');
            const query = state.searchQuery.toLowerCase().trim();
            listEl.innerHTML = '';

            Object.values(MOLECULES).forEach(mol => {
                // Filter by category
                if (state.category !== 'all' && mol.category !== state.category) return;
                // Filter by search query
                if (query) {
                    const hay = `${mol.name} ${mol.formula} ${mol.shortShape} ${mol.angles} ${mol.geometry}`.toLowerCase();
                    if (!hay.includes(query)) return;
                }

                const isActive = (state.viewMode === 'single' && state.selectedId === mol.id);
                const btn = document.createElement('button');
                btn.className = `w-full text-left px-3 py-2.5 rounded-xl border transition-all flex items-center justify-between gap-2 ${
                    isActive
                        ? 'bg-sky-600/20 border-sky-500/60 text-white shadow-sm'
                        : 'bg-slate-950/60 border-slate-800/80 text-slate-300 hover:bg-slate-800/60 hover:border-slate-700'
                }`;

                btn.innerHTML = `
                    <div class="min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span class="font-semibold text-xs truncate ${isActive ? 'text-white' : 'text-slate-200'}">${mol.name}</span>
                        </div>
                        <div class="text-[11px] text-slate-400 truncate mt-0.5">${mol.shortShape}</div>
                    </div>
                    <span class="font-mono text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-900 border border-slate-700/80 text-sky-300 shrink-0">
                        ${mol.formula}
                    </span>
                `;

                btn.addEventListener('click', () => {
                    state.selectedId = mol.id;
                    if (state.viewMode !== 'single') {
                        setViewMode('single');
                    } else {
                        renderMoleculeList();
                        applySceneLayout();
                        applyVisualToggles();
                        updateInfoPanel();
                        updateDynamicLegend();
                    }
                });

                listEl.appendChild(btn);
            });
        }

        /**
         * Populate the 3 Dropdown Selectors in Compare Studio
         */
        function populateCompareSelects() {
            const selects = [
                document.getElementById('compare-slot-0'),
                document.getElementById('compare-slot-1'),
                document.getElementById('compare-slot-2')
            ];

            selects.forEach((sel, slotIdx) => {
                sel.innerHTML = '';
                Object.values(MOLECULES).forEach(mol => {
                    const opt = document.createElement('option');
                    opt.value = mol.id;
                    opt.textContent = `${mol.name} (${mol.formula})`;
                    if (state.compareSlots[slotIdx] === mol.id) opt.selected = true;
                    sel.appendChild(opt);
                });

                sel.addEventListener('change', (e) => {
                    state.compareSlots[slotIdx] = e.target.value;
                    applySceneLayout();
                    applyVisualToggles();
                    updateInfoPanel();
                    updateDynamicLegend();
                });
            });
        }

        /**
         * Switch between Single Explorer and 3-Way Compare Studio
         */
        function setViewMode(mode) {
            state.viewMode = mode;
            const singleBtn = document.getElementById('view-single-btn');
            const compareBtn = document.getElementById('view-compare-btn');
            const compareBar = document.getElementById('compare-selector-bar');

            if (mode === 'single') {
                singleBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-sky-600 text-white shadow-sm';
                compareBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-amber-400 hover:text-amber-300 hover:bg-slate-800/70 flex items-center gap-1.5';
                compareBar.classList.add('hidden');
            } else {
                compareBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-amber-500 text-slate-950 shadow-sm flex items-center gap-1.5';
                singleBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white hover:bg-slate-800/70';
                compareBar.classList.remove('hidden');
            }

            renderMoleculeList();
            applySceneLayout();
            applyVisualToggles();
            updateInfoPanel();
            updateDynamicLegend();
        }

        /**
         * Position Active Molecule(s) in 3D Viewport
         */
        function applySceneLayout() {
            // Hide all groups first
            Object.values(moleculeGroups).forEach(g => {
                g.visible = false;
                g.position.set(0, 0, 0);
            });

            if (state.viewMode === 'single') {
                const grp = moleculeGroups[state.selectedId];
                if (grp) {
                    grp.visible = true;
                    grp.position.set(0, 0, 0);
                    grp.rotation.set(grp.userData.initialTiltX || 0.25, 0, 0);
                }
                camera.position.copy(CAMERA_PRESETS.single.pos);
                controls.target.copy(CAMERA_PRESETS.single.target);
            } else {
                const xOffsets = [-8.6, 0, 8.6];
                state.compareSlots.forEach((molId, idx) => {
                    const grp = moleculeGroups[molId];
                    if (grp) {
                        grp.visible = true;
                        grp.position.set(xOffsets[idx], 0, 0);
                        grp.rotation.set(grp.userData.initialTiltX || 0.25, 0, 0);
                    }
                });
                camera.position.copy(CAMERA_PRESETS.compare.pos);
                controls.target.copy(CAMERA_PRESETS.compare.target);
            }
            controls.update();
        }

        /**
         * Update Ball-and-Stick vs Space-Filling, Wireframes, and Lone Pairs
         */
        function applyVisualToggles() {
            const isSpaceFill = state.style === 'spacefill';

            atomMeshes.forEach(({ mesh, bsRadius, vdwRadius }) => {
                mesh.scale.setScalar(isSpaceFill ? vdwRadius : bsRadius);
            });
            bondMeshes.forEach(bond => {
                bond.visible = !isSpaceFill;
            });
            wireframeGroups.forEach(wf => {
                wf.visible = state.showWireframe;
            });
            lonePairGroups.forEach(lp => {
                lp.visible = state.showLonePairs && !isSpaceFill;
            });

            // Highlight Lone Pairs toggle button when active molecule actually has lone pairs
            const activeIds = state.viewMode === 'single' ? [state.selectedId] : state.compareSlots;
            const anyHasLP = activeIds.some(id => MOLECULES[id] && MOLECULES[id].hasLonePairs);
            const lpBtn = document.getElementById('toggle-lonepairs');
            lpBtn.classList.toggle('opacity-40', !anyHasLP);
        }

        /**
         * Dynamically Update the Top-Left CPK Element Legend for Active Structure(s)
         */
        function updateDynamicLegend() {
            const legendEl = document.getElementById('dynamic-legend');
            const activeIds = state.viewMode === 'single' ? [state.selectedId] : state.compareSlots;
            const elemSet = new Set();

            activeIds.forEach(id => {
                const mol = MOLECULES[id];
                if (mol) mol.elements.forEach(el => elemSet.add(el));
            });

            legendEl.innerHTML = Array.from(elemSet).map(key => {
                const el = getElementProps(key);
                return `
                    <div class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full inline-block border border-white/25" style="background-color: ${el.css}"></span>
                        <span class="text-slate-200 font-medium">${el.symbol} <span class="text-slate-400 text-[10px]">(${el.name})</span></span>
                    </div>
                `;
            }).join('');
        }

        /**
         * Parse V2000 SDF/MOL or XYZ 3D Coordinate Files & Build 3D Mesh
         */
        function parseAndBuildStructure({ id, name, formula, sdfText, xyzText, sourceLabel, meta = {} }) {
            const atoms = [];
            const bonds = [];

            if (sdfText) {
                const lines = sdfText.split(/\r?\n/);
                let countsIdx = lines.findIndex(l => l.includes('V2000'));
                if (countsIdx === -1 && lines.length > 3) countsIdx = 3;

                const countsLine = lines[countsIdx] || '';
                const numAtoms = parseInt(countsLine.substring(0, 3).trim(), 10);
                const numBonds = parseInt(countsLine.substring(3, 6).trim(), 10);

                if (!isNaN(numAtoms) && numAtoms > 0) {
                    for (let i = 0; i < numAtoms; i++) {
                        const line = lines[countsIdx + 1 + i];
                        if (!line || line.startsWith('$$$$')) break;
                        const x = parseFloat(line.substring(0, 10).trim());
                        const y = parseFloat(line.substring(10, 20).trim());
                        const z = parseFloat(line.substring(20, 30).trim());
                        const el = line.substring(31, 34).trim();
                        if (!isNaN(x) && !isNaN(y) && !isNaN(z) && el) {
                            atoms.push({ el, pos: new THREE.Vector3(x, y, z) });
                        }
                    }
                    for (let j = 0; j < numBonds; j++) {
                        const line = lines[countsIdx + 1 + numAtoms + j];
                        if (!line || line.startsWith('$$$$')) break;
                        const a1 = parseInt(line.substring(0, 3).trim(), 10) - 1;
                        const a2 = parseInt(line.substring(3, 6).trim(), 10) - 1;
                        const order = parseInt(line.substring(6, 9).trim(), 10) || 1;
                        if (atoms[a1] && atoms[a2]) {
                            bonds.push({ a1, a2, order: Math.min(order, 4) });
                        }
                    }
                }
            } else if (xyzText) {
                const lines = xyzText.trim().split(/\r?\n/).filter(l => l.trim().length > 0);
                const startIdx = !isNaN(parseInt(lines[0].trim(), 10)) ? 2 : 0;
                for (let i = startIdx; i < lines.length; i++) {
                    const parts = lines[i].trim().split(/\s+/);
                    if (parts.length >= 4) {
                        const el = parts[0];
                        const x = parseFloat(parts[1]);
                        const y = parseFloat(parts[2]);
                        const z = parseFloat(parts[3]);
                        if (!isNaN(x) && !isNaN(y) && !isNaN(z)) {
                            atoms.push({ el, pos: new THREE.Vector3(x, y, z) });
                        }
                    }
                }
                for (let i = 0; i < atoms.length; i++) {
                    for (let j = i + 1; j < atoms.length; j++) {
                        const d = atoms[i].pos.distanceTo(atoms[j].pos);
                        const hasH = atoms[i].el === 'H' || atoms[j].el === 'H';
                        const maxD = hasH ? 1.25 : 1.88;
                        if (d > 0.35 && d <= maxD) {
                            bonds.push({ a1: i, a2: j, order: 1 });
                        }
                    }
                }
            }

            if (atoms.length === 0) {
                throw new Error('No valid 3D atomic coordinates found in structure.');
            }

            // Center & normalize scale so molecule fits cleanly inside the viewport
            const center = new THREE.Vector3();
            atoms.forEach(a => center.add(a.pos));
            center.divideScalar(atoms.length);
            atoms.forEach(a => a.pos.sub(center));

            let maxDist = 0.1;
            atoms.forEach(a => {
