                subtitleEl.textContent = 'Simultaneous structural analysis of three active molecular slots';
                roleBadgeEl.textContent = 'Comparative Analysis';
                roleBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-amber-500/15 text-amber-400 border border-amber-500/30';
